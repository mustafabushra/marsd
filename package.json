{
  "name": "marsad-react",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-report-template.mjs && vite build",
    "preview": "vite preview",
    "check:enums": "node scripts/check-enum-drift.mjs",
    "lint": "eslint src api scripts",
    "build:report": "node scripts/build-report-template.mjs",
    "check:tiles": "node scripts/probe-tile-truth.mjs",
    "check:nav": "node scripts/probe-admin-nav.mjs",
    "check:features": "node scripts/probe-admin-features.mjs",
    "check:model-privacy": "node scripts/check-trust-model-privacy.mjs",
    "check:doc-urls": "node scripts/check-document-url-safety.mjs",
    "check:schema-drift": "node scripts/check-schema-drift.mjs",
    "check:authz": "node scripts/check-authorization.mjs",
    "check:input": "node scripts/check-input-validation.mjs",
    "check:all": "npm run check:enums && npm run check:schema-drift && npm run check:authz && npm run check:input && npm run check:files && npm run check:api && npm run check:model-privacy && npm run check:doc-urls && npm run check:tiles",
    "check:files": "node scripts/check-file-safety.mjs",
