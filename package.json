    "playwright-core": "^1.62.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.19",
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.2.0",
