# Clerk Authentication Configuration — TEMPLATE
# Copy to .env.clerk and fill in. .env.clerk is git-ignored.
# Get these from https://dashboard.clerk.com/

# Publishable Key (public, safe to expose in the browser bundle)
VITE_CLERK_PUBLISHABLE_KEY=

# Secret Key (NEVER commit — server-only, used by api/invite-user.js)
CLERK_SECRET_KEY=

# App ID (from dashboard URL or settings)
CLERK_APP_ID=
